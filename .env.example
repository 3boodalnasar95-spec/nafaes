# Admin Panel Credentials
# IMPORTANT: These values should be set in your deployment environment
# Never commit the actual credentials to version control

# Admin username (required for admin panel login)
VITE_ADMIN_USERNAME=admin

# Admin password - set this in your actual .env file
# VITE_ADMIN_PASSWORD=your_secure_password_here

# Supabase Configuration (if using database)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key